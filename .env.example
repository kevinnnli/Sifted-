# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---- Administrator (required for the admin portal) -------------------------
# The only way to get an administrator account. On every start the server makes
# sure this account exists and that ADMIN_PASSWORD is its password. Changing
# ADMIN_EMAIL disables the previous administrator. Nobody can create or promote
# an administrator from inside the web app.
ADMIN_EMAIL="admin@your-university.edu"
# At least 12 characters. Use a long, unique password.
ADMIN_PASSWORD=""
# Optional display name for the admin account.
ADMIN_NAME="Administrator"

# ---- Operator details (shown in the Privacy Policy and Terms) --------------
# Who runs this deployment. Until these are set, the policy pages say that the
# operator has not published their details.
# SITE_OPERATOR="Example University, Graduate Admissions Office"
# SITE_CONTACT_EMAIL="privacy@example.edu"

# ---- Students -------------------------------------------------------------
# By default, new student accounts must be verified by the administrator before
# they can see or take assigned tests (this stops someone registering with
# another student's university email). Set to "auto" to skip that step.
# STUDENT_VERIFICATION="auto"

# ---- AI (optional) --------------------------------------------------------
# GEMINI_API_KEY: enables AI grading feedback, question generation and briefings.
# Without it the app uses deterministic grading and template questions.
# AI Studio injects this automatically from the Secrets panel.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"
# Upper limit in milliseconds for one AI call; on timeout the built-in grade is used.
# AI_TIMEOUT_MS="20000"

# ---- Test accounts ---------------------------------------------------------
# A sandbox professor and students (passwords shown only in the admin portal)
# are created automatically. Set to "off" to never create them.
# SIFTED_TEST_ACCOUNTS="off"

# ---- Demo data (optional) -------------------------------------------------
# Seeds sample professors, students, assessments and submissions into a NEW
# database. All sample accounts share DEMO_PASSWORD (at least 8 characters).
# Do not enable this on a real deployment.
# SEED_DEMO_DATA="true"
# DEMO_PASSWORD=""

# ---- Vercel / serverless storage -------------------------------------------
# On Vercel the disk is temporary, so data is kept in Upstash Redis instead.
# Connecting an Upstash database to the Vercel project sets these for you.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ---- Hosting --------------------------------------------------------------
# PORT="3000"
# Where accounts and results are stored (default: ./database.json).
# DATABASE_FILE="/var/lib/sifted/database.json"
# Set when running behind a reverse proxy outside production mode.
# TRUST_PROXY="true"
# Only for previews that load the app inside an iframe from another site
# (for example AI Studio): allows framing and cross-site session cookies.
# Requires HTTPS. Leave unset otherwise.
# ALLOW_EMBEDDING="true"
# COOKIE_SAMESITE="none"

# APP_URL: The URL where this applet is hosted (injected by AI Studio).
APP_URL="MY_APP_URL"
